def cmd_design(args) -> int:
    """Build a kicadgen design file into a KiCad project, routing it when asked."""
    sys.path.insert(0, str(SRC_DIR / "tools"))
    import kicadgen

    design_path = Path(args.design).resolve()
    out_dir = Path(args.out).resolve() if args.out else design_path.parent
    t0 = time.monotonic()
    design = kicadgen.load_design(design_path)
    summary: dict = {
        "design": str(design_path),
        "name": design.name,
        "parts": len(design.parts),
        "nets": len(design.net_names()),
    }
    code = EXIT_PASS
    # Vias are checked before anything is written or routed: every via size against the board's own
    # rules, since the router places most vias and the DRC of an unrouted board sees none (M46); and
    # each hand via's place, since a via passes every layer, and one in a keepout or on another face's
    # pad is a short the DRC would only find later (M40, M41).
    summary["via_problems"] = design.check_via_rules() + design.check_vias()
    # Control inputs that can float (a gate, an enable, a switch, an I2C line with nothing holding it):
    # listed for every design, and a failure for one that sets check_pulls.
    summary["pulls"] = design.undefined_inputs()
    if summary["pulls"] and design.check_pulls:
        code = EXIT_FAIL
    if summary["via_problems"]:
        code = EXIT_FAIL
    if args.route:
        fixed_segments, fixed_vias = list(design.segments), list(design.vias)  # hand-routed copper
        try:
            for round_no in range(1, args.rounds + 1):
                summary["route"] = kicadgen.route(
                    design, out_dir / "build" / "route", passes=args.passes, timeout=args.timeout
                )
                summary["files"] = [str(p) for p in design.write(out_dir)]
                summary["rounds"] = round_no
                if not design.islands or round_no == args.rounds:
                    break
                # Pads walled off from their pour: reserve a via beside each, then route again around it.
                design.segments = list(fixed_segments)
                design.vias = list(fixed_vias)
                if not design.reserve_vias([pad for island in design.islands for pad in island]):
                    break
                fixed_vias = list(design.vias)
            if summary["route"].get("unrouted"):
                code = EXIT_FAIL
        except FileNotFoundError as exc:
            summary["route"] = {"skip": f"engine missing: {exc}"}
            code = EXIT_SKIP
    if "files" not in summary:
        summary["files"] = [str(p) for p in design.write(out_dir)]
    summary["islands"] = design.islands
    summary["seconds"] = round(time.monotonic() - t0, 2)
    if args.json:
        print(json.dumps(summary, indent=2))
    else:
        print(
            f"design {design.name}: {summary['parts']} parts, {summary['nets']} nets  [{summary['seconds']}s]"
        )
        r = summary.get("route")
        if r and "skip" in r:
            print(f"  route skipped: {r['skip']}")
        elif r:
            unrouted = "DRC decides" if r["unrouted"] is None else f"{r['unrouted']} unrouted"
            rounds = f"{summary.get('rounds', 1)} round(s)"
            print(f"  routed: {r['segments']} segments, {r['vias']} vias, {unrouted}, {rounds}  ({r['log']})")
        for line in summary["pulls"]:
            print(f"  pull: {line}")
        for problem in summary["via_problems"]:
            print(f"  via: {problem}")
        for island in summary["islands"]:
            print(f"  island: {', '.join(island)} cut off from their pour; the DRC will report it")
        for f in summary["files"]:
            print(f"  wrote {f}")
    return code


KISTACK_DIR = Path(os.environ.get("KISTACK_DIR", SRC_DIR / "third_party" / "kistack"))
# kistack's layout-placement checks that only read the board. move.py edits a board KiCad has open;
# a generated board changes in its design file instead.
PLACEMENT_CHECKS = ("pin_sides", "placement_audit", "route_check", "local_search", "group_search")
# Run one check with tools/kistack_board.py standing in for kistack's IPC reader.
PLACEMENT_RUNNER = """
import runpy, sys
sys.path.insert(0, sys.argv[1])
import kistack_board
sys.modules["ipc_board"] = kistack_board
script = sys.argv[2]
sys.argv = [script, *sys.argv[3:]]
runpy.run_path(script, run_name="__main__")
"""
# KiCad's Python module writes these to stderr on every load; they say nothing about the board.
KICAD_NOISE = re.compile(r"Debug: Adding duplicate image handler|property\.h\(\d+\): assert")


def venv_python() -> str:
    """The workcenter venv's Python (KiCad's pcbnew module, shapely), else this one."""
    py = WC_ROOT / "venv" / "bin" / "python"
    return str(py) if py.exists() else sys.executable


def cmd_placement(args) -> int:
    """Run one of kistack's layout-placement checks on a board file, headless."""
    name = args.check.removesuffix(".py")
    if name == "move":
        print(
            "placement: kistack's move.py edits a board that KiCad has open. A generated board changes in "
            "its design file: put the new position in design.py and run `workcenter design` again.",
            file=sys.stderr,
        )
        return EXIT_SKIP
    if name not in PLACEMENT_CHECKS:
        raise SystemExit(f"placement: {args.check!r} is not one of {', '.join(PLACEMENT_CHECKS)}")
    script = KISTACK_DIR / "skills" / "layout-placement" / "scripts" / f"{name}.py"
    if not script.is_file():
        print(f"placement: {script} is missing (KISTACK_DIR={KISTACK_DIR})", file=sys.stderr)
        return EXIT_SKIP
    project = find_project(args.board)
    if project.pcb is None:
        raise SystemExit(f"placement: {project.dir} has no .kicad_pcb")
    env = {**os.environ, "PYTHONDONTWRITEBYTECODE": "1"}
    proc = subprocess.run(
        [venv_python(), "-s", "-c", PLACEMENT_RUNNER, str(SRC_DIR / "tools"), str(script), str(project.pcb)]
        + list(args.args),
        capture_output=True,
        text=True,
        env=env,
    )
    sys.stdout.write(proc.stdout)
    sys.stderr.write("".join(ln for ln in proc.stderr.splitlines(True) if not KICAD_NOISE.search(ln)))
    if "No module named 'shapely'" in proc.stderr or "No module named 'pcbnew'" in proc.stderr:
        return EXIT_SKIP
    return EXIT_PASS if proc.returncode == 0 else EXIT_FAIL


USER_SETTINGS = Path.home() / ".claude" / "settings.json"


def no_cd_hook_installed(settings: Path = USER_SETTINGS) -> bool:
    """True when the user-wide Claude Code settings run the no-cd hook (install.sh puts it there, M35)."""
    try:
        data = json.loads(settings.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    entries = data.get("hooks", {}).get("PreToolUse", []) if isinstance(data, dict) else []
    return any("no_cd.py" in h.get("command", "") for e in entries for h in e.get("hooks", []))


def cmd_doctor(args) -> int:
    kicad = tool_version([KICAD_CLI, "version"])
    ngspice = tool_version([NGSPICE, "--version"], r"(?<=ngspice-)\d+")
    java = tool_version([JAVA, "-version"], r'(?<=version ")\d+(\.\d+)*')
    py = f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}"
    checks = {
        "kicad-cli": {"required": True, "ok": bool(kicad and kicad.startswith("10.")), "version": kicad},
        "ngspice": {"required": True, "ok": bool(ngspice), "version": ngspice},
        "python": {"required": True, "ok": sys.version_info >= (3, 12), "version": py},
        "java": {"required": False, "ok": bool(java and int(java.split(".")[0]) >= 21), "version": java},
        "freerouting": {"required": False, "ok": FREEROUTING_JAR.is_file(), "path": str(FREEROUTING_JAR)},
        "venv": {
            "required": False,
            "ok": (WC_ROOT / "venv" / "bin" / "python").exists(),
            "path": str(WC_ROOT / "venv"),
        },
        "xvfb": {"required": False, "ok": shutil.which("Xvfb") is not None},
        "rsvg-convert": {"required": False, "ok": shutil.which("rsvg-convert") is not None},
        "ffmpeg": {"required": False, "ok": shutil.which("ffmpeg") is not None},
        "symbols": {
            "required": False,
            "ok": Path("/usr/share/kicad/symbols/Device.kicad_sym").is_file(),
            "path": "/usr/share/kicad/symbols",
        },
        "manifest": {
            "required": True,
            "ok": (SRC_DIR / "WORKCENTER.md").is_file(),
            "path": str(SRC_DIR / "WORKCENTER.md"),
        },
        "no-cd hook": {"required": False, "ok": no_cd_hook_installed(), "path": str(USER_SETTINGS)},
        "kistack": {
            "required": False,
            "ok": (KISTACK_DIR / "skills" / "layout-placement" / "scripts").is_dir(),
            "path": str(KISTACK_DIR),
        },
    }
    missing_required = [k for k, v in checks.items() if v["required"] and not v["ok"]]
    degraded = [k for k, v in checks.items() if not v["required"] and not v["ok"]]
    status = "fail" if missing_required else ("degraded" if degraded else "ok")
    payload = {
        "status": status,
        "root": str(WC_ROOT),
        "src": str(SRC_DIR),
        "checks": checks,
        "missing_required": missing_required,
        "degraded": degraded,
    }
    if args.json:
        print(json.dumps(payload, indent=2))
    else:
        print(f"workcenter ee: {status}  (root {WC_ROOT}, src {SRC_DIR})")
        for name, c in checks.items():
            mark = "ok " if c["ok"] else ("MISSING" if c["required"] else "absent ")
            extra = c.get("version") or c.get("path") or ""
            print(f"  {mark:8} {name:12} {extra}")
    return EXIT_FAIL if missing_required else EXIT_PASS


def emit(results: list[Result], args, out: Path | None = None) -> int:
    statuses = {r.status for r in results}
    if statuses & {"fail", "error"}:
        worst = EXIT_FAIL
    elif "skip" in statuses and "pass" not in statuses:
        worst = EXIT_SKIP
    else:
        worst = EXIT_PASS
    if out is not None:
        (out / "gates.json").write_text(json.dumps([asdict(r) for r in results], indent=2), encoding="utf-8")
    if args.json:
        print(json.dumps([asdict(r) for r in results], indent=2))
    else:
        for r in results:
            print(f"{r.status.upper():6} {r.gate:10} {r.summary}  [{r.seconds}s]")
            for v in r.details.get("first", [])[:5]:
                print(f"       - {v.get('severity')}: {v.get('type')}: {v.get('description')}")
            for f in r.details.get("failures", [])[:5]:
                print(f"       - {f}")
    return worst


def cmd_gate(args, fn, **kwargs) -> int:
    project = find_project(args.project)
    out = out_dir_for(project, args.out)
    # A single gate writes its own report into `out`; only `gates` writes the combined gates.json.
    return emit([fn(project, out, **kwargs)], args, None)


def cmd_gates(args) -> int:
    project = find_project(args.project)
    out = out_dir_for(project, args.out)
    results: list[Result] = []
    for gate in GATE_ORDER:
        fn = {"erc": gate_erc, "drc": gate_drc, "sim": gate_sim, "export": gate_export}[gate]
        kwargs = {"strict": args.strict}
        if gate == "export":
            kwargs["step"] = args.step
        if gate == "drc":
            kwargs["fab"] = args.fab
        result = fn(project, out, **kwargs)
        results.append(result)
        if result.status in ("fail", "error"):
            break
    code = emit(results, args, out)
    if not args.json:
        verdict = "GREEN" if code == EXIT_PASS else ("SKIPPED" if code == EXIT_SKIP else "RED")
        print(f"{verdict}: {project.name}  report {out / 'gates.json'}")
    return code


def render_views(value: str) -> tuple[str, ...]:
    names = RENDER_VIEWS if value == "all" else tuple(v.strip() for v in value.split(",") if v.strip())
    unknown = [v for v in names if v not in RENDER_VIEWS]
    if unknown or not names:
        raise argparse.ArgumentTypeError(f"views are {', '.join(RENDER_VIEWS)} or all, not {value!r}")
    return names


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="workcenter", description=__doc__.splitlines()[0])
    parser.add_argument("--json", action="store_true", help="machine-readable output")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("doctor", help="report engine status")

    def add_project_cmd(name: str, help_text: str):
        p = sub.add_parser(name, help=help_text)
        p.add_argument("project", help="project directory or a .kicad_pro/.kicad_sch/.kicad_pcb file")
        p.add_argument("--out", help="output directory (default <project>/build)")
        p.add_argument("--strict", action="store_true", help="warnings fail the gate")
        return p

    add_project_cmd("erc", "electrical rules check on the schematic")
    p = add_project_cmd("drc", "design rules check on the board, with schematic parity")
    p.add_argument("--fab", help="also check a fab's limits: a rule set in rules/ or a .kicad_dru path")
    add_project_cmd("sim", "run ngspice on sim/*.cir and check *.expect.json bounds")
    p = add_project_cmd("export", "fabrication outputs: gerbers, drill, BOM, schematic PDF")
    p.add_argument("--step", action="store_true", help="also export a STEP model")
    p = add_project_cmd("gates", "run erc, drc, sim, export in order; stop at the first red")
    p.add_argument("--step", action="store_true", help="also export a STEP model")
    p.add_argument(
        "--fab", help="the DRC also checks a fab's limits: a rule set in rules/ or a .kicad_dru path"
    )
    p = add_project_cmd("autoroute", "run FreeRouting on the project's Specctra DSN, write a .ses")
    p.add_argument("--dsn", help="Specctra DSN exported from KiCad (default <project>/<name>.dsn)")
    p.add_argument("--passes", type=int, default=20)
    p.add_argument("--threads", type=int, default=0)
    p.add_argument("--timeout", type=int, default=600)
    p = add_project_cmd(
        "render", "images: schematic, board top/bottom, 3D views, every layer; a turning 3D GIF on request"
    )
    p.add_argument("--width", type=int, default=1600, help="image width in pixels")
    p.add_argument(
        "--views",
        type=render_views,
        default=",".join(DEFAULT_VIEWS),
        help=f"comma-separated, from {', '.join(RENDER_VIEWS)}, or all (default {','.join(DEFAULT_VIEWS)})",
    )
    p.add_argument("--spin-frames", type=int, default=36, help="frames in the turning GIF (views spin)")
    p.add_argument(
        "--spin-tilt", type=float, default=-55.0, help="the GIF's tilt about the board's x axis, degrees"
    )
    p.add_argument(
        "--spin-zoom", type=float, default=1.0, help="the GIF's zoom; below 1 keeps tall parts in frame"
    )
    p.add_argument(
        "--spin-pivot",
        help="the GIF's pivot, x,y,z in cm from the board's centre (kicad-cli --pivot); z for tall parts",
    )
    p = add_project_cmd(
        "procure", "price the schematic's BOM from parts files; writes procure/bom.csv, parts.csv, parts.md"
    )
    p.add_argument(
        "--parts",
        action="append",
        metavar="FILE",
        help="a parts CSV (repeatable; the first row that matches a line wins); default <project>/parts.csv",
    )
    p.add_argument(
        "--boards", type=board_counts, default="1,10", help="units to price, comma-separated (default 1,10)"
    )
    p = add_project_cmd(
        "sources",
        "each part's datasheet, SPICE model and 3D body against library/sources.csv; --fetch rereads them",
    )
    p.add_argument(
        "--parts",
        action="append",
        metavar="FILE",
        help="a parts CSV naming each line's MPN (repeatable); default <project>/parts.csv",
    )
    p.add_argument(
        "--sources", help="the library's sources.csv (default: the nearest library/sources.csv above)"
    )
    p.add_argument(
        "--fetch", action="store_true", help="read every URL again and compare it with the library's copy"
    )
    p = sub.add_parser(
        "design", help="build a kicadgen design.py into a KiCad project; --route runs FreeRouting"
    )
    p.add_argument("design", help="path to a design file exposing build() -> kicadgen.Design")
    p.add_argument("--out", help="output directory (default: the design file's directory)")
    p.add_argument("--route", action="store_true", help="export DSN, run FreeRouting, merge the session")
    p.add_argument("--passes", type=int, default=60)
    p.add_argument("--timeout", type=int, default=900)
    p.add_argument(
        "--rounds", type=int, default=4, help="route again with a via reserved beside each pad a pour lost"
    )
    p = sub.add_parser(
        "placement",
        help="run a kistack layout-placement check on a board file: " + ", ".join(PLACEMENT_CHECKS),
    )
    p.add_argument("check", help=f"one of {', '.join(PLACEMENT_CHECKS)}")
    p.add_argument("board", help="project directory or .kicad_pcb")
    p.add_argument("args", nargs=argparse.REMAINDER, help="the check's own arguments, e.g. U1 or --ic U1")

    args = parser.parse_args(argv)
    if args.command == "doctor":
        return cmd_doctor(args)
    if args.command == "placement":
        return cmd_placement(args)
    if args.command == "design":
        return cmd_design(args)
    if args.command == "render":
        return cmd_gate(
            args,
            gate_render,
            width=args.width,
            views=args.views,
            spin_frames=args.spin_frames,
            spin_tilt=args.spin_tilt,
            spin_zoom=args.spin_zoom,
            spin_pivot=args.spin_pivot,
            strict=args.strict,
        )
    if args.command == "gates":
        return cmd_gates(args)
    if args.command == "procure":
        return cmd_procure(args)
    if args.command == "sources":
        return cmd_sources(args)
    if args.command == "autoroute":
        return cmd_gate(
            args, gate_autoroute, dsn=args.dsn, passes=args.passes, threads=args.threads, timeout=args.timeout
        )
    fn = {"erc": gate_erc, "drc": gate_drc, "sim": gate_sim, "export": gate_export}[args.command]
    kwargs = {"strict": args.strict}
    if args.command == "export":
        kwargs["step"] = args.step
    if args.command == "drc":
        kwargs["fab"] = args.fab
    return cmd_gate(args, fn, **kwargs)


if __name__ == "__main__":
    sys.exit(main())
