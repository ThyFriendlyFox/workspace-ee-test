#!/usr/bin/env python3
"""workcenter — the EE Workcenter command line.

Runs the engines (KiCad 10 kicad-cli, ngspice, FreeRouting) against a
KiCad project and reports pass or fail per gate. Standard library only,
Python 3.12 or later.

Exit codes: 0 every gate passed, 1 a gate failed or an engine errored,
2 a gate skipped because an engine or input is missing.
"""

from __future__ import annotations

import argparse
import json
import math
import os
import re
import shutil
import subprocess
import sys
import time
from dataclasses import asdict, dataclass, field
from pathlib import Path

WC_ROOT = Path(os.environ.get("WORKCENTER_ROOT", "/opt/workcenters/ee"))
SRC_DIR = Path(__file__).resolve().parent.parent
FREEROUTING_JAR = Path(os.environ.get("FREEROUTING_JAR", WC_ROOT / "freerouting" / "freerouting.jar"))
KICAD_CLI = os.environ.get("KICAD_CLI", "kicad-cli")
NGSPICE = os.environ.get("NGSPICE", "ngspice")
JAVA = os.environ.get("JAVA", "java")

EXIT_PASS, EXIT_FAIL, EXIT_SKIP = 0, 1, 2
GATE_ORDER = ("erc", "drc", "sim", "export")
# What `render` can draw; the turning GIF takes a minute or two, so it is drawn only when asked for.
RENDER_VIEWS = ("schematic", "2d", "3d", "layers", "spin")
DEFAULT_VIEWS = ("schematic", "2d", "3d", "layers")
# Technical layers drawn one per image after the copper, front before back.
LAYER_IMAGES = (
    "F.Silkscreen",
    "B.Silkscreen",
    "F.Mask",
    "B.Mask",
    "F.Paste",
    "B.Paste",
    "F.Fab",
    "B.Fab",
    "F.Courtyard",
    "B.Courtyard",
    "Edge.Cuts",
)
LAYER_BACKGROUND = "#001023"  # KiCad's board-editor background: silkscreen and courtyards stay visible
DRAWN = re.compile(r"<(path|circle|polygon|polyline|rect|line|ellipse|text)\b")
SPIN_WIDTH = 640  # GIF frames: wider ones make a GIF of tens of megabytes


@dataclass
class Result:
    gate: str
    status: str  # pass | fail | skip | error
    summary: str
    details: dict = field(default_factory=dict)
    artifacts: list[str] = field(default_factory=list)
    seconds: float = 0.0

    @property
    def exit_code(self) -> int:
        return {"pass": EXIT_PASS, "skip": EXIT_SKIP}.get(self.status, EXIT_FAIL)


@dataclass
class Project:
    dir: Path
    name: str
    pro: Path | None
    sch: Path | None
    pcb: Path | None


# ---------------------------------------------------------------- helpers


def run(cmd: list[str], cwd: Path | None = None, timeout: int = 900) -> subprocess.CompletedProcess:
    return subprocess.run(
        [str(c) for c in cmd],
        cwd=str(cwd) if cwd else None,
        capture_output=True,
        text=True,
        timeout=timeout,
        check=False,
    )


def tool_version(cmd: list[str], pattern: str = r"\d+(\.\d+)+") -> str | None:
    exe = shutil.which(cmd[0])
    if not exe:
        return None
    try:
        proc = run(cmd, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None
    text = (proc.stdout or "") + (proc.stderr or "")
    match = re.search(pattern, text)
    return match.group(0) if match else (text.strip().splitlines() or ["?"])[0]


def find_project(path: str) -> Project:
    p = Path(path).resolve()
    if p.is_file():
        stem_dir, stem = p.parent, p.stem
    elif p.is_dir():
        pros = sorted(p.glob("*.kicad_pro"))
        if len(pros) > 1:
            raise SystemExit(f"{p}: {len(pros)} .kicad_pro files; name one")
        if pros:
            stem_dir, stem = p, pros[0].stem
        else:
            schs = sorted(p.glob("*.kicad_sch"))
            pcbs = sorted(p.glob("*.kicad_pcb"))
            cand = schs or pcbs
            if cand:
                stem_dir, stem = p, cand[0].stem
            elif (p / "sim").is_dir():
                stem_dir, stem = p, p.name  # simulation-only project: decks, no board yet
            else:
                raise SystemExit(f"{p}: no KiCad project, schematic, board or sim/ directory found")
    else:
        raise SystemExit(f"{p}: not found")

    def opt(suffix: str) -> Path | None:
        f = stem_dir / f"{stem}{suffix}"
        return f if f.is_file() else None

    return Project(
        dir=stem_dir, name=stem, pro=opt(".kicad_pro"), sch=opt(".kicad_sch"), pcb=opt(".kicad_pcb")
    )


def out_dir_for(project: Project, override: str | None) -> Path:
    out = Path(override).resolve() if override else project.dir / "build"
    out.mkdir(parents=True, exist_ok=True)
    return out


def load_json(path: Path) -> dict:
    with path.open(encoding="utf-8") as fh:
        return json.load(fh)


def count_severity(items: list[dict]) -> dict[str, int]:
    counts = {"error": 0, "warning": 0, "other": 0}
    for item in items:
        sev = str(item.get("severity", "other")).lower()
        counts[sev if sev in counts else "other"] += 1
    return counts


def first_violations(items: list[dict], limit: int = 10) -> list[dict]:
    out = []
    for v in items[:limit]:
        pos = None
        for it in v.get("items", []):
            if "pos" in it:
                pos = it["pos"]
                break
        out.append(
            {
                "type": v.get("type"),
                "severity": v.get("severity"),
                "description": v.get("description"),
                "pos": pos,
            }
        )
    return out


def timed(fn):
    def wrapper(*args, **kwargs) -> Result:
        t0 = time.monotonic()
        try:
            result = fn(*args, **kwargs)
        except FileNotFoundError as exc:
            result = Result(fn.__name__.removeprefix("gate_"), "skip", f"engine missing: {exc.filename}")
        except subprocess.TimeoutExpired as exc:
            result = Result(fn.__name__.removeprefix("gate_"), "error", f"timed out after {exc.timeout}s")
        result.seconds = round(time.monotonic() - t0, 2)
        return result

    return wrapper


# ------------------------------------------------------------------ gates


@timed
def gate_erc(project: Project, out: Path, strict: bool = False) -> Result:
    if not project.sch:
        return Result("erc", "skip", "no schematic in project")
    report = out / "erc.json"
    proc = run(
        [
            KICAD_CLI,
            "sch",
            "erc",
            "--output",
            report,
            "--format",
            "json",
            "--severity-all",
            "--exit-code-violations",
            project.sch,
        ],
        cwd=project.dir,
    )
    if proc.returncode not in (0, 5) or not report.is_file():
        return Result("erc", "error", f"kicad-cli exited {proc.returncode}", {"stderr": proc.stderr[-2000:]})
    data = load_json(report)
    violations = [v for sheet in data.get("sheets", []) for v in sheet.get("violations", [])]
    counts = count_severity(violations)
    red = counts["error"] > 0 or (strict and counts["warning"] > 0)
    return Result(
        "erc",
        "fail" if red else "pass",
        f"{counts['error']} errors, {counts['warning']} warnings",
        {"counts": counts, "first": first_violations(violations)},
        [str(report)],
    )


@timed
def gate_drc(project: Project, out: Path, strict: bool = False) -> Result:
    if not project.pcb:
        return Result("drc", "skip", "no board in project")
    report = out / "drc.json"
    cmd = [
        KICAD_CLI,
        "pcb",
        "drc",
        "--output",
        report,
        "--format",
        "json",
        "--severity-all",
        "--exit-code-violations",
    ]
    if project.sch:
        cmd.append("--schematic-parity")
    cmd.append(project.pcb)
    proc = run(cmd, cwd=project.dir)
    if proc.returncode not in (0, 5) or not report.is_file():
        return Result("drc", "error", f"kicad-cli exited {proc.returncode}", {"stderr": proc.stderr[-2000:]})
    data = load_json(report)
    groups = {k: data.get(k, []) for k in ("violations", "unconnected_items", "schematic_parity")}
    counts = {k: count_severity(v) for k, v in groups.items()}
    errors = sum(c["error"] for c in counts.values())
    warnings = sum(c["warning"] for c in counts.values())
    red = errors > 0 or (strict and warnings > 0)
    return Result(
        "drc",
        "fail" if red else "pass",
        f"{errors} errors, {warnings} warnings "
        f"({len(groups['unconnected_items'])} unconnected, {len(groups['schematic_parity'])} parity)",
        {
            "counts": counts,
            "first": first_violations(
                groups["violations"] + groups["unconnected_items"] + groups["schematic_parity"]
            ),
        },
        [str(report)],
    )


MEASURE_RE = re.compile(r"^\s*([A-Za-z_][\w]*)\s*=\s*([-+]?[\d.]+(?:[eE][-+]?\d+)?)")
NGSPICE_ERROR_RE = re.compile(r"^(Error|.*\berror on line\b|Fatal|.*: no such)", re.IGNORECASE)


@timed
def gate_sim(project: Project, out: Path, strict: bool = False) -> Result:
    sim_dir = project.dir / "sim"
    decks = sorted(sim_dir.glob("*.cir")) if sim_dir.is_dir() else []
    if not decks:
        return Result("sim", "skip", "no sim/*.cir in project")
    if not shutil.which(NGSPICE):
        return Result("sim", "skip", f"engine missing: {NGSPICE}")
    sim_out = out / "sim"
    sim_out.mkdir(parents=True, exist_ok=True)
    details, artifacts, failures = {}, [], []
    for deck in decks:
        log = sim_out / f"{deck.stem}.log"
        proc = run([NGSPICE, "-b", "-o", log, deck.name], cwd=sim_dir)
        text = log.read_text(encoding="utf-8", errors="replace") if log.is_file() else ""
        text += "\n" + (proc.stdout or "") + (proc.stderr or "")
        errors = [ln.strip() for ln in text.splitlines() if NGSPICE_ERROR_RE.match(ln)]
        measures = {}
        for ln in text.splitlines():
            m = MEASURE_RE.match(ln)
            if m:
                measures[m.group(1)] = float(m.group(2))
        expect_file = sim_dir / f"{deck.stem}.expect.json"
        checks = {}
        if expect_file.is_file():
            for name, bounds in load_json(expect_file).items():
                value = measures.get(name)
                ok = value is not None and bounds.get("min", float("-inf")) <= value <= bounds.get(
                    "max", float("inf")
                )
                checks[name] = {"value": value, "min": bounds.get("min"), "max": bounds.get("max"), "ok": ok}
                if not ok:
                    failures.append(
                        f"{deck.stem}:{name}={value} not in [{bounds.get('min')}, {bounds.get('max')}]"
                    )
        if proc.returncode != 0 or errors:
            failures.append(f"{deck.stem}: ngspice exit {proc.returncode}, {len(errors)} error lines")
        details[deck.stem] = {
            "exit": proc.returncode,
            "errors": errors[:10],
            "measures": measures,
            "checks": checks,
        }
        artifacts.append(str(log))
    return Result(
        "sim",
        "fail" if failures else "pass",
        f"{len(decks)} decks, {len(failures)} failures",
        {"decks": details, "failures": failures},
        artifacts,
    )


@timed
def gate_export(project: Project, out: Path, strict: bool = False, step: bool = False) -> Result:
    if not project.pcb:
        return Result("export", "skip", "no board in project")
    fab = out / "fab"
    fab.mkdir(parents=True, exist_ok=True)
    gerbers = fab / "gerbers"
    gerbers.mkdir(exist_ok=True)
    jobs: list[tuple[str, list[str], Path]] = [
        ("gerbers", [KICAD_CLI, "pcb", "export", "gerbers", "--output", f"{gerbers}/", project.pcb], gerbers),
        ("drill", [KICAD_CLI, "pcb", "export", "drill", "--output", f"{gerbers}/", project.pcb], gerbers),
    ]
    if project.sch:
        jobs.append(
            (
                "bom",
                [KICAD_CLI, "sch", "export", "bom", "--output", fab / "bom.csv", project.sch],
                fab / "bom.csv",
            )
        )
        jobs.append(
            (
                "schematic-pdf",
                [KICAD_CLI, "sch", "export", "pdf", "--output", fab / "schematic.pdf", project.sch],
                fab / "schematic.pdf",
            )
        )
    if step:
        jobs.append(
            (
                "step",
                [KICAD_CLI, "pcb", "export", "step", "--output", fab / f"{project.name}.step", project.pcb],
                fab / f"{project.name}.step",
            )
        )
    details, artifacts, failures = {}, [], []
    for name, cmd, expect in jobs:
        proc = run(cmd, cwd=project.dir)
        produced = expect.is_file() if expect.suffix else any(expect.iterdir())
        ok = proc.returncode == 0 and produced
        details[name] = {
            "exit": proc.returncode,
            "produced": produced,
            "stderr": proc.stderr[-800:] if not ok else "",
        }
        if ok:
            artifacts.append(str(expect))
        else:
            failures.append(name)
    gerber_files = sorted(p.name for p in gerbers.iterdir()) if gerbers.is_dir() else []
    details["gerber_files"] = gerber_files
    return Result(
        "export",
        "fail" if failures else "pass",
        f"{len(jobs) - len(failures)}/{len(jobs)} outputs, {len(gerber_files)} gerber files",
        details,
        artifacts,
    )


@timed
def gate_autoroute(
    project: Project,
    out: Path,
    dsn: str | None = None,
    passes: int = 20,
    threads: int = 0,
    timeout: int = 600,
) -> Result:
    if not project.pcb:
        return Result("autoroute", "skip", "no board in project")
    if not FREEROUTING_JAR.is_file():
        return Result("autoroute", "skip", f"engine missing: {FREEROUTING_JAR}")
    if not shutil.which(JAVA):
        return Result("autoroute", "skip", f"engine missing: {JAVA}")
    # kicad-cli 10 has no Specctra export. The DSN comes from KiCad
    # (File > Export > Specctra DSN) next to the board, or from --dsn.
    candidates = (
        [Path(dsn)] if dsn else [project.dir / f"{project.name}.dsn", out / "route" / f"{project.name}.dsn"]
    )
    dsn_path = next((c for c in candidates if c.is_file()), None)
    if dsn_path is None:
        return Result(
            "autoroute",
            "skip",
            "no Specctra DSN: kicad-cli 10 cannot export one; export it from KiCad or pass --dsn",
            {"looked_for": [str(c) for c in candidates]},
        )
    route = out / "route"
    route.mkdir(parents=True, exist_ok=True)
    ses = route / f"{project.name}.ses"
    cmd = [JAVA, "-jar", FREEROUTING_JAR, "-de", dsn_path, "-do", ses, "-mp", str(passes)]
    if threads:
        cmd += ["-mt", str(threads)]
    proc = run(cmd, cwd=route, timeout=timeout)
    if proc.returncode != 0 or not ses.is_file():
        return Result(
            "autoroute",
            "fail",
            f"FreeRouting exited {proc.returncode}",
            {"stderr": (proc.stderr or proc.stdout)[-1500:]},
        )
    return Result(
        "autoroute",
        "pass",
        f"session file written: {ses.name}",
        {
            "note": "import the .ses into the board with KiCad (File > Import > Specctra Session), "
            "then run drc"
        },
        [str(dsn_path), str(ses)],
    )


def copper_layers(pcb: Path) -> list[str]:
    """The board's copper layers, top to bottom, as its layer table lists them."""
    text = pcb.read_text(encoding="utf-8", errors="replace")
    table = re.search(r"\(layers\s*((?:\(\s*\d+\s+\"[^\"]+\"[^()]*\)\s*)+)\)", text)
    return re.findall(r"\(\s*\d+\s+\"([^\"]+\.Cu)\"", table.group(1)) if table else []


def png_size(png: Path) -> tuple[int, int]:
    """Width and height from a PNG's header."""
    head = png.read_bytes()[:24]
    return int.from_bytes(head[16:20], "big"), int.from_bytes(head[20:24], "big")


def layer_sheet(plotted: list[tuple[str, Path]], rdir: Path) -> tuple[Path, int]:
    """An SVG that lays the layer images out in a grid, each under its name, for rsvg-convert to flatten.
    The images are referenced from `layers/`, below the sheet, which librsvg allows."""
    w0, h0 = png_size(plotted[0][1])
    cols = max(1, min(len(plotted), round(math.sqrt(len(plotted) * 1.6 * h0 / w0))))
    cell_w = 600 if w0 >= h0 else 250
    cell_h = max(round(cell_w * png_size(p)[1] / png_size(p)[0]) for _, p in plotted)
    label, gap = 22, 14
    rows = math.ceil(len(plotted) / cols)
    width, height = cols * cell_w + (cols + 1) * gap, rows * (cell_h + label) + (rows + 1) * gap
    parts = [
        f'<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" '
        f'width="{width}" height="{height}">',
        f'<rect width="{width}" height="{height}" fill="{LAYER_BACKGROUND}"/>',
    ]
    for i, (layer, png) in enumerate(plotted):
        x = gap + (i % cols) * (cell_w + gap)
        y = gap + (i // cols) * (cell_h + label + gap)
        name = layer + (", from below" if layer.startswith("B.") else "")
        w, h = png_size(png)
        parts.append(
            f'<text x="{x}" y="{y + 16}" fill="#e8e8e8" font-family="DejaVu Sans, sans-serif" '
            f'font-size="15">{name}</text>'
        )
        parts.append(
            f'<image x="{x}" y="{y + label}" width="{cell_w}" height="{round(cell_w * h / w)}" '
            f'xlink:href="layers/{png.name}"/>'
        )
    sheet = rdir / "layers.svg"
    sheet.write_text("\n".join([*parts, "</svg>"]) + "\n", encoding="utf-8")
    return sheet, width


@timed
def gate_render(
    project: Project,
    out: Path,
    width: int = 1600,
    views: tuple[str, ...] = DEFAULT_VIEWS,
    spin_frames: int = 36,
    spin_tilt: float = -55.0,
    spin_zoom: float = 1.0,
    spin_pivot: str | None = None,
) -> Result:
    """Images of the design: schematic, board top and bottom (2D), board 3D top, bottom and isometric,
    every layer on its own with an overview sheet, and on request a GIF that turns the 3D board round."""
    rdir = out / "render"
    rdir.mkdir(parents=True, exist_ok=True)
    artifacts: list[str] = []
    failures: list[str] = []
    skipped: list[str] = []
    rsvg = shutil.which("rsvg-convert")

    def to_png(svg: Path, png: Path, w: int, background: str = "white") -> bool:
        if not rsvg:
            skipped.append(f"{png.name}: rsvg-convert missing")
            return False
        proc = run([rsvg, "-w", str(w), "-b", background, "-o", png, svg])
        if proc.returncode == 0 and png.is_file():
            artifacts.append(str(png))
            return True
        failures.append(png.name)
        return False

    def render_3d(png: Path, w: int, extra: list[str]) -> bool:
        cmd = [
            KICAD_CLI,
            "pcb",
            "render",
            "--output",
            png,
            "--width",
            str(w),
            "--height",
            str(int(w * 0.625)),
            "--background",
            "opaque",
            "--quality",
            "high",
            *extra,
            project.pcb,
        ]
        if not os.environ.get("DISPLAY") and shutil.which("xvfb-run"):
            cmd = ["xvfb-run", "-a", *cmd]
        proc = run(cmd, cwd=project.dir, timeout=300)
        return proc.returncode == 0 and png.is_file()

    def plot_svg(svg: Path, layers: str, extra: list[str]) -> bool:
        proc = run(
            [
                KICAD_CLI,
                "pcb",
                "export",
                "svg",
                "--output",
                svg,
                "--layers",
                layers,
                "--page-size-mode",
                "2",
                "--mode-single",
                "--exclude-drawing-sheet",
                *extra,
                project.pcb,
            ],
            cwd=project.dir,
        )
        return proc.returncode == 0 and svg.is_file()

    if project.sch and "schematic" in views:
        before = set(rdir.glob("*.svg"))
        proc = run(
            [
                KICAD_CLI,
                "sch",
                "export",
                "svg",
                "--output",
                f"{rdir}/",
                "--no-background-color",
                "--exclude-drawing-sheet",
                project.sch,
            ],
            cwd=project.dir,
        )
        new = sorted(set(rdir.glob("*.svg")) - before, key=lambda p: p.stat().st_mtime)
        if proc.returncode == 0 and new:
            svg = new[-1].replace(rdir / "schematic.svg")
            artifacts.append(str(svg))
            to_png(svg, rdir / "schematic.png", width * 2)
        else:
            failures.append("schematic.svg")
    if project.pcb and "2d" in views:
        for name, layers, extra in (
            ("board-top", "F.Cu,F.SilkS,F.Mask,Edge.Cuts", []),
            ("board-bottom", "B.Cu,B.SilkS,B.Mask,Edge.Cuts", ["--mirror"]),
        ):
            svg = rdir / f"{name}.svg"
            if plot_svg(svg, layers, extra):
                artifacts.append(str(svg))
                to_png(svg, rdir / f"{name}.png", width)
            else:
                failures.append(svg.name)
    if project.pcb and "3d" in views:
        for name, extra in (
            ("board-3d-top", []),
            ("board-3d-bottom", ["--side", "bottom"]),
            ("board-3d-iso", ["--rotate", "-35,0,25", "--perspective"]),
        ):
            png = rdir / f"{name}.png"
            if render_3d(png, width, extra):
                artifacts.append(str(png))
            else:
                failures.append(png.name)
    if project.pcb and "layers" in views:
        ldir = rdir / "layers"
        shutil.rmtree(ldir, ignore_errors=True)
        ldir.mkdir()
        plotted: list[tuple[str, Path]] = []
        for layer in [*copper_layers(project.pcb), *LAYER_IMAGES]:
            # Drawn on its own without drill holes, which show on every layer: an empty layer draws
            # nothing and gets no image. A layer the board does not have writes no file.
            probe = ldir / "probe.svg"
            drawn = plot_svg(probe, layer, ["--drill-shape-opt", "0"]) and bool(
                DRAWN.search(probe.read_text(encoding="utf-8", errors="replace"))
            )
            probe.unlink(missing_ok=True)
            if not drawn:
                continue
            name = layer.replace(".", "-")
            svg = ldir / f"{name}.svg"
            both = layer if layer == "Edge.Cuts" else f"{layer},Edge.Cuts"
            if not plot_svg(svg, both, ["--mirror"] if layer.startswith("B.") else []):
                failures.append(f"layers/{name}.png")
                continue
            if to_png(svg, ldir / f"{name}.png", width, LAYER_BACKGROUND):
                plotted.append((layer, ldir / f"{name}.png"))
            svg.unlink()
        if plotted:
            sheet, sheet_w = layer_sheet(plotted, rdir)
            to_png(sheet, rdir / "layers.png", sheet_w, LAYER_BACKGROUND)
            sheet.unlink()
    if project.pcb and "spin" in views:
        ffmpeg = shutil.which("ffmpeg")
        gif = rdir / "board-spin.gif"
        if not ffmpeg:
            skipped.append(f"{gif.name}: ffmpeg missing")
        else:
            frames = rdir / "spin-frames"
            shutil.rmtree(frames, ignore_errors=True)
            frames.mkdir()
            # Turned about the board's normal, tilted toward the viewer; the GIF loops at 12 frames a second.
            ok = all(
                render_3d(
                    frames / f"{i:03d}.png",
                    min(width, SPIN_WIDTH),
                    [
                        "--rotate",
                        f"{spin_tilt:g},0,{360 * i / spin_frames:.2f}",
                        "--perspective",
                        "--zoom",
                        f"{spin_zoom:g}",
                        *(["--pivot", spin_pivot] if spin_pivot else []),
                    ],
                )
                for i in range(spin_frames)
            )
            if ok:
                palette = "split[a][b];[a]palettegen=stats_mode=full[p];[b][p]paletteuse=dither=sierra2_4a"
                proc = run(
                    [
                        ffmpeg,
                        "-y",
                        "-loglevel",
                        "error",
                        "-framerate",
                        "12",
                        "-i",
                        frames / "%03d.png",
                        "-vf",
                        palette,
                        "-loop",
                        "0",
                        gif,
                    ]
                )
                ok = proc.returncode == 0 and gif.is_file()
            if ok:
                artifacts.append(str(gif))
            else:
                failures.append(gif.name)
            shutil.rmtree(frames, ignore_errors=True)
    if not artifacts:
        return Result("render", "skip", "nothing rendered", {"failures": failures, "skipped": skipped})
    return Result(
        "render",
        "fail" if failures else "pass",
        f"{len(artifacts)} images in {rdir}" + (f", {len(skipped)} skipped" if skipped else ""),
        {"failures": failures, "skipped": skipped},
        artifacts,
    )


